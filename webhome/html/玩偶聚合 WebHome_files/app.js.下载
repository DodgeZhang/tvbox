  function focusables(){
    var root=scope();
    var els=Array.prototype.slice.call(root.querySelectorAll(SEL)).filter(vis);
    if(root===document){
      var sheet=document.getElementById('sheet');
      if(sheet) els=els.filter(function(el){return !sheet.contains(el);});
