      if(!b){
        hc.innerHTML='<button class="det-play-btn" id="detPlayBtn" aria-label="立即播放"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg></button>';
