    function refreshPlayBtn(markValid){
      const hc=document.querySelector('.det-hero-cta'); if(!hc) return;
      const p=_playTarget||(d.pans&&d.pans[0])||null;
      if(!p||!p.url){ hc.innerHTML=''; return; }
