  const attempts=[
    {ep:epn, quality:'1080'},
    {ep:epn, quality:'hd'},
    {ep:epn, definition:'high'},
    {ep:epn}
  ];
  let best='';
  for(let i=0;i<attempts.length;i++){
    try{
      const r=await huangguoaiReq(s,'/api/videos/'+encodeURIComponent(vid)+'/play', attempts[i]);
