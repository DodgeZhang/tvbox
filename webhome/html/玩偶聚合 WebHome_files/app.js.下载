            if(_currentDetailItem!==v) return;
            appendOne(p);
          }
        }
        await Promise.all([worker(), worker()]);
      }catch(e){}
    })();

    // 盘搜 / 觅盘：进详情已预启动，此处只挂结果（Tab 不显示数量）
    const panBox=$('#panSearchBox');
    const mipanBox=$('#mipanBox');
