const _cg57BlobCache={};
async function chigua57HydrateCovers(root){
  try{
    root=root||document;
    const imgs=[...root.querySelectorAll('img[data-cg57-src]')];
    if(!imgs.length) return;
    let fm=null;
    try{ fm=window.fm||(typeof fmReady==='function'?await fmReady():null); }catch(e){}
    for(const img of imgs){
      if(img.getAttribute('data-cg57-done')==='1' && img.complete && img.naturalWidth>0) continue;
      const raw=img.getAttribute('data-cg57-src');
      if(!raw) continue;
      const ok=function(){
        try{
          img.setAttribute('data-cg57-done','1');
          img.style.display='';
          img.style.opacity='1';
          img.dataset.failed='';
          const poster=img.closest('.poster');
          if(poster){
            const ph=poster.querySelector('.noimg');
            if(ph) ph.remove();
            poster.dataset.fb='';
          }
        }catch(e){}
      };
      if(img.complete && img.naturalWidth>0){ ok(); continue; }
      try{
        if(fm&&fm.res){
          const gated=fm.res(raw,{headers:Object.assign(chigua57MediaHeaders(),{'Accept':'image/*,*/*'})});
          if(gated){
            const success=await new Promise(function(resolve){
              const t=setTimeout(function(){ resolve(false); }, 12000);
              img.addEventListener('load', function(){ clearTimeout(t); ok(); resolve(true); }, {once:true});
              img.addEventListener('error', function(){ clearTimeout(t); resolve(false); }, {once:true});
              img.src=gated;
            });
            if(success) continue;
          }
        }
        if(fm&&fm.req){
          if(typeof _cg57BlobCache!=='undefined' && _cg57BlobCache[raw]){ img.src=_cg57BlobCache[raw]; ok(); continue; }
          const r=await fm.req(raw,{method:'GET',headers:Object.assign(chigua57MediaHeaders(),{'Accept':'image/*,*/*'}),responseType:'arraybuffer',timeout:20});
          if(r&&r.ok&&r.body!=null){
            let body=r.body;
            if(!(body instanceof ArrayBuffer) && body.buffer) body=body.buffer;
            const blob=new Blob([body],{type:'image/jpeg'});
            const bu=URL.createObjectURL(blob);
            try{ _cg57BlobCache[raw]=bu; }catch(e){}
            img.src=bu;
            ok();
          }
        }
      }catch(e){}
    }
  }catch(e){}
}

