function chigua57ParseCards(html, s, base){
  const out=[];
  const seen=new Set();
  const re=/href="(\/events\/(\d+)\/?)"[^>]*>[\s\S]*?<img[^>]+src="([^"]+)"[^>]*alt="([^"]*)"/gi;
  let m;
  while((m=re.exec(html))){
    const path=m[1], id=m[2], pic=m[3], title=(m[4]||'').trim();
    if(!id||seen.has(id)) continue;
    seen.add(id);
    const t=chigua57CleanTitle(title||'')||('吃瓜 #'+id);
    out.push({
      title:t,
      name:t,
      href:chigua57Abs(base, path),
      pic:pic||'',
      remark:'',
      siteId:s.id,
      siteName:s.name||'吃瓜',
      _chigua57Id:id,
      _noTmdb:true
    });
  }
  // fallback: looser match if structure differs
  if(!out.length){
    const re2=/href="(\/events\/(\d+)\/?)"/gi;
    while((m=re2.exec(html))){
      const path=m[1], id=m[2];
      if(!id||seen.has(id)) continue;
      seen.add(id);
      // try find nearby img/alt
      const slice=html.slice(Math.max(0,m.index-50), m.index+800);
      const im=slice.match(/src="(https?:\/\/[^"]+\.(?:jpg|jpeg|png|webp)[^"]*)"/i);
      const am=slice.match(/alt="([^"]+)"/i);
      const t=chigua57CleanTitle((am&&am[1]||'').trim())||('吃瓜 #'+id);
      out.push({
        title:t,name:t,href:chigua57Abs(base,path),pic:im?im[1]:'',remark:'',
        siteId:s.id,siteName:s.name||'吃瓜',_chigua57Id:id,_noTmdb:true
      });
    }
  }
  return out;
}
