    .replace(/(?:\s|·|—|–|-|_|\||\/)*(?:高清|超清|蓝光|4K|1080[Pp]?|720[Pp]?)?(?:完整版|完整)?(?:在线)?(?:免费)?(?:下载|观看|播放|点播)(?:专区|地址|链接)?\s*$/i,'')
