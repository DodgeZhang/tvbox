    var url='https://t.me/nostremby';
    try{
      if(window.fm&&typeof fm.open==='function'){ fm.open(url); return; }
      if(window.fm&&fm.ui&&typeof fm.ui.openUrl==='function'){ fm.ui.openUrl(url); return; }
    }catch(_e){}
    try{ window.open(url,'_blank','noopener,noreferrer'); }catch(_e){
      try{ location.href=url; }catch(__e){}
    }
  }
  function bindPromo(){
    var el=document.getElementById('promoTgRow');
    if(!el||el._promoBound) return;
    el._promoBound=1;
    el.addEventListener('click', openPromoChannel, true);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', bindPromo);
  else bindPromo();
  setTimeout(bindPromo, 800);
})();

