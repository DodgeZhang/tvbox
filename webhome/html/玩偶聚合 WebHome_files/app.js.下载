  function extractVideosFromHtml(html){
    const out=[];
    const re=/<video\b([^>]*)>/gi;
    let m;
    while((m=re.exec(html))){
      const attrs=m[1]||'';
      const hls=(attrs.match(/data-hls-src=["']([^"']+)["']/i)||[])[1]||'';
      const mp4=(attrs.match(/data-fallback-src=["']([^"']+)["']/i)||[])[1]||'';
      const poster=(attrs.match(/poster=["']([^"']+)["']/i)||[])[1]||'';
      const url=(hls||mp4||'').trim();
      if(!url) continue;
      out.push({url:url, hls:hls||'', mp4:mp4||'', poster:poster||''});
    }
    // 兜底：无 video 标签时捞裸链
    if(!out.length){
      const hlsAll=[...html.matchAll(/data-hls-src=["']([^"']+)["']/gi)].map(x=>x[1]);
      const fbAll=[...html.matchAll(/data-fallback-src=["']([^"']+)["']/gi)].map(x=>x[1]);
      const n=Math.max(hlsAll.length, fbAll.length);
      for(let i=0;i<n;i++){
        const hls=hlsAll[i]||'', mp4=fbAll[i]||'', url=hls||mp4;
        if(url) out.push({url, hls, mp4, poster:''});
      }
    }
    if(!out.length){
      const contentUrls=[...html.matchAll(/"contentUrl"\s*:\s*"(https?:\/\/[^"]+)"/gi)].map(x=>x[1]);
      contentUrls.forEach(u=>out.push({url:u, hls:/\.m3u8/i.test(u)?u:'', mp4:/\.mp4/i.test(u)?u:'', poster:''}));
    }
    return out;
  }
  function epName(n){ return '第'+n+'集'; }

  try{
    let path=id ? '/events/'+id+'/' : '';
    let href=v&&v.href;
    if(!path && href){
      try{ const u=new URL(href); path=u.pathname; }catch(e){ path=href; }
    }
    const r=await get(s, path||href);
    const html=r.html||'';
    // title
    let hm=html.match(/<h1[^>]*>([^<]+)</i);
    if(hm&&hm[1]) info.title=hm[1].trim();
    if(!info.title){
