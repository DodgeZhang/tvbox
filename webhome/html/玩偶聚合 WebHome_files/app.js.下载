    if(dm) try{ info.desc=JSON.parse('"'+dm[1]+'"'); }catch(e){ info.desc=dm[1]; }

    const meta=parseSeriesMeta(info.title);
    const localVids=extractVideosFromHtml(html);
    // 本帖视频 → 分集编号
    let epItems=[]; // {name,url,ep,pageUrl,title}
    if(localVids.length){
      const span=Math.max(1, (meta.end-meta.start+1));
      localVids.forEach((vid,i)=>{
        let n;
        if(localVids.length===1){
          n=meta.start||1;
        }else if(span===localVids.length){
          n=meta.start+i;
        }else{
          n=(meta.start||1)+i;
        }
        epItems.push({
          name:epName(n),
          url:vid.url,
          ep:n,
          pageUrl:pageUrl,
          title:info.title,
          _hls:vid.hls,
          _mp4:vid.mp4
        });
      });
    }

    // 同系列其它帖：用系列名搜索，把各帖分集一并收齐
    if(meta.series && meta.series.length>=2){
      try{
        const sibs=await chigua57Search(s, meta.series);
        // 按 ep 排序收集，限制并发
        const tasks=[];
        for(const it of (sibs||[])){
          const sid=String(it._chigua57Id||(String(it.href||'').match(/\/events\/(\d+)/)||[])[1]||'');
          if(!sid || sid===String(id)) continue; // 本帖已解析
          const sm=parseSeriesMeta(it.title||it.name||'');
          // 系列名需匹配（防止搜到无关）
          if(sm.series && sm.series!==meta.series && meta.series.indexOf(sm.series)<0 && sm.series.indexOf(meta.series)<0) continue;
          tasks.push({it, sid, sm});
        }
        // 最多再拉 12 个帖，避免太慢
        const slice=tasks.slice(0,12);
        const conc=3;
        let ti=0;
        async function worker(){
          while(ti<slice.length){
            const cur=slice[ti++];
            try{
              const rr=await get(s, '/events/'+cur.sid+'/');
              const vids=extractVideosFromHtml(rr.html||'');
              if(!vids.length) continue;
              const sm=cur.sm||parseSeriesMeta(cur.it.title||'');
              const span=Math.max(1, (sm.end-sm.start+1));
              vids.forEach((vid,i)=>{
                let n;
                if(vids.length===1) n=sm.start||1;
                else if(span===vids.length) n=sm.start+i;
                else n=(sm.start||1)+i;
                // 去重：同集号已有则跳过
                if(epItems.some(e=>e.ep===n && e.url)) return;
                epItems.push({
                  name:epName(n),
                  url:vid.url,
                  ep:n,
                  pageUrl:cur.it.href||('https://57cg4.com/events/'+cur.sid+'/'),
                  title:cur.it.title||info.title,
                  _hls:vid.hls,
                  _mp4:vid.mp4
                });
              });
            }catch(e){}
          }
        }
        await Promise.all(Array.from({length:Math.min(conc, slice.length||1)}, ()=>worker()));
      }catch(eSer){
        console&&console.warn&&console.warn('[chigua57 series]', eSer&&eSer.message);
      }
    }

    // 排序、去重
    epItems.sort((a,b)=>(a.ep-b.ep)||String(a.url).localeCompare(String(b.url)));
    const seenEp=new Set();
    const seenUrl=new Set();
    epItems=epItems.filter(e=>{
      if(!e.url||seenUrl.has(e.url)) return false;
      // 同集号保留先出现的
      if(seenEp.has(e.ep)) return false;
      seenEp.add(e.ep);
      seenUrl.add(e.url);
      return true;
    });

    // 组装 pans + 全集列表（推给播放器）
    const allEpisodes=epItems.map(e=>({
      name:e.name,
      url:e.url,
      type:'在线',
      _online:true,
      _chigua57:true,
      siteName:s.name||'吃瓜',
      title:e.title||info.title,
      pageUrl:e.pageUrl||pageUrl
    }));

    if(allEpisodes.length){
      allEpisodes.forEach((ep,i)=>{
        pans.push(Object.assign({}, ep, {
          _allEpisodes:allEpisodes,
          _epIndex:i
        }));
      });
    }

    if(info.pic && v){
      try{ v.pic=info.pic; v._sitePic=info.pic; v._noTmdb=true; }catch(e){}
    }
    // 标题去掉单集后缀，播放页显示系列名更干净
    if(meta.series){
      try{
        info.title=meta.series;
        if(v){ v.title=meta.series; v.name=meta.series; }
      }catch(e){}
    }
  }catch(e){
    console&&console.warn&&console.warn('[chigua57]',e&&e.message);
  }
  return {info, pans};
}

