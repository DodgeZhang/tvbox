      if(_currentDetailItem!==v) return;
      const candidates=(list||[]).filter(x=>x&&x.url&&!/^magnet:/i.test(x.url)&&!/^ed2k:/i.test(x.url));
      for(let i=0;i<Math.min(candidates.length,8);i++){
