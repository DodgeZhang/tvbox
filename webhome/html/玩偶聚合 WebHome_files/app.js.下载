      renderGzSections(list._gzSections);
      // 板块模式关闭无限滚动（官网板块为定长）
      try{teardownInfiniteScroll()}catch(e){}
    }else{
      renderGrid(list,true);
    }
    const st=`${s.name} · 第 ${pg} 页 · ${list.length} 条`;
